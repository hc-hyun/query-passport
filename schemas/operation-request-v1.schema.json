{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Query Passport lifecycle operation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "profile_version",
    "scope",
    "environment",
    "deployment_alias",
    "target_alias",
    "profile",
    "source_count",
    "operation"
  ],
  "properties": {
    "contract_version": {
      "const": "1",
      "type": "string"
    },
    "profile_version": {
      "const": 1,
      "type": "integer"
    },
    "scope": {
      "const": "database-only"
    },
    "environment": {
      "enum": [
        "local-synthetic",
        "local",
        "protected"
      ]
    },
    "deployment_alias": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "target_alias": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "host",
        "port",
        "database",
        "sslmode",
        "authentication"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*(?![\\s\\S])"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
        },
        "sslmode": {
          "const": "verify-full"
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "client-certificate"
            }
          }
        }
      }
    },
    "source_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "required_capabilities": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "profile.inspect.v1",
          "plan.offline.v1",
          "connection.verify.v1",
          "lifecycle.local.v1",
          "credential.rotate.local.v1"
        ]
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "plan_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        }
      }
    }
  },
  "description": "For issue, apply, deliver, rotate, rollback and status. An operation reference selects a private plan and grants no authority."
}
